# ==============================================================================
# XeooAuditor — Git Ignore Configuration
# Privacy-first, zero-leak policy for public repository distribution
# ==============================================================================

# Dependencies & Compiled Artifacts
node_modules/
dist/
build/
vendor/
.next/
out/

# Environment Variables, Secrets & Credentials
.env
.env.*
!.env.example
config.local.php
**/config.local.php
*.pem
*.key
*.cert
*.crt
secrets/
credentials/

# Database Files, Dumps & Schema Migrations
database.sql
*.sql
*.sqlite
*.sqlite3
*.db
*.sql.gz
*.dump
migrations/*.sql
backend/migrations/

# Agent Workflows, Skills & Private Prompt Directives
.agents/
.agents/**
.codex/
.cursor/
AGENTS.md
agent.md
CLAUDE.md

# Test Suites, Diagnostic Scripts & Scratch (Excluded from Public Repo)
tests/
**/tests/
backend/tests/
frontend/tests/
*.test.*
*.spec.*
backend/test_*.php
test_*.php
scratch/

# Runtime Logs, Caches & Temporary Storage
*.log
logs/
tmp/
cache/
.phpunit.cache/
playwright-report/
test-results/

# OS & IDE System Files
.DS_Store
Thumbs.db
.vscode/
.idea/
